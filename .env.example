# Application code loads .env. For agents: ln .env env.txt; test .env -ef env.txt.
# Names use DUBVIBE_MINI_. Legacy YOUDUB_ names are still read when the new name is unset.
# Optional Host paths and interface; empty values use platform defaults.
DUBVIBE_MINI_DESKTOP_DATA_DIR=
DUBVIBE_MINI_PYTHON=
DUBVIBE_MINI_HOST=127.0.0.1
DUBVIBE_MINI_PORT=8000
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=

# Browser session settings. No access password is required.
DUBVIBE_MINI_AUTH_SESSION_TTL_SECONDS=604800
DUBVIBE_MINI_AUTH_COOKIE_SECURE=false
DUBVIBE_MINI_AUTH_COOKIE_SAMESITE=strict
DUBVIBE_MINI_AUTH_COOKIE_NAME=

# Optional explicit paths. FFmpeg needs libass/subtitles support.
# macOS example: /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# Windows requires shared/full-shared FFmpeg with av*.dll beside ffmpeg.exe.
FFMPEG_PATH=
FFPROBE_PATH=
LOCAL_UPLOAD_MAX_BYTES=4294967296

# Model paths default to the models directory beneath the application data root.
DUBVIBE_MINI_WHISPER_MODELS_DIR=
DUBVIBE_MINI_DEMUCS_MODELS_DIR=
DUBVIBE_MINI_VOXCPM_MODEL_DIR=
DUBVIBE_MINI_FORCED_ALIGNER_MODEL_DIR=
DUBVIBE_MINI_TRANSLATION_MODELS=gpt-4.1-mini
DUBVIBE_MINI_SUBTITLE_FONT=

# Translation URL and key are configured in Settings; keys use system keyring.
# Model and device selections belong to workflow configuration.
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
